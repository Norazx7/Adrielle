{
  "manifest_version": 3,
  "name": "GLPI Triagem Auto",
  "version": "1.0.0",
  "description": "Preenche e adiciona a tarefa de triagem no GLPI (Feito + witorio.couto + grupo TRIAGEM).",
  "author": "Witório Bandeira",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GLPI Triagem Auto",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/fab.css"],
      "run_at": "document_idle"
    }
  ]
}
