{
  "manifest_version": 3,
  "name": "Triar Auto — Processos & Despacho",
  "version": "1.4.0",
  "description": "Automação multi-aba anti-pausa: watchdog, reattach e cliques em TRIAR PROCESSOS / Criar Despacho.",
  "author": "Witório Bandeira",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Triar Auto",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "alarms", "activeTab", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
